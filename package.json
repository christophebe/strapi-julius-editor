{
  "name": "@web-evasion/strapi-julius-editor",
  "version": "0.1.6",
  "description": "A drop-in replacement for the strapi editor based on tiptap with components & AI",
  "strapi": {
    "name": "strapi-julius-editor",
    "description": "A drop-in replacement for the strapi editor with tiptap with components & AI",
    "kind": "plugin",
    "displayName": "Julius Editor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophebe/strapi-julius-editor.git"
  },
  "keywords": [
    "strapi",
    "tiptap",
    "editor",
    "AI editor",
    "Content blocks editor"
  ],
  "author": "christophebe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christophebe/strapi-julius-editor/issues"
  },
  "homepage": "https://github.com/christophebe/strapi-julius-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": ">=10.12.0"
  },
  "files": [
